# Copy to `.env` in this directory for local overrides (optional).
# All settings use the POKER_AI_ prefix (see src/poker_ai/config/settings.py).

# POKER_AI_DEBUG=false
# Default DB is poker_ai/data/poker_ai.db (absolute path from package root). If set, ingest/db commands use this URL instead:
# POKER_AI_DATABASE_URL=sqlite+aiosqlite:///D:/Poker AI/poker_ai/data/custom.db
# POKER_AI_PLAYER_UID_HMAC_SECRET=change-me-in-production

# Optional: full-corpus ingest performance test (see README / doc/ROADMAP.md Phase 1).
# POKER_AI_PERF_INGEST=1
# POKER_AI_CORPUS_ROOT=D:/Poker AI/hand
# POKER_AI_PERF_MIN_HANDS=17000
# POKER_AI_PERF_BUDGET_SEC=90

# Optional: stop directory ingest after N hands (dev / large PHH trees).
# POKER_AI_INGEST_MAX_HANDS=15000
