.dockerignore
docker-compose.override.yml

# Kubernetes
*.yaml.local
*.yml.local

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# ===== IGNORE PATTERNS =====
# Ignore all files starting with 'temp_' or 'debug_'
temp_*
debug_*

# Ignore all .local files
*.local

# Ignore all backup directories
*_backup/
backup_*/

# ===== KEEP THESE FILES =====
# Force include important files that might be ignored
!.gitkeep
!.env.example
!requirements.txt
!package.json
!README.md
!LICENSE 